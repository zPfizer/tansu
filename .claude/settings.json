{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "py -3 -X utf8 \"$CLAUDE_PROJECT_DIR/kurulum/oturum_baslangic.py\"",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/WINDOWS/System32/WindowsPowerShell/v1.0/powershell.exe -NoProfile -NonInteractive -EncodedCommand ",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Bash(*git rebase*)",
      "Bash(*--amend*)",
      "Bash(*git checkout .)",
      "Bash(*git checkout . *)",
      "Bash(*git restore .)",
      "Bash(*git restore . *)",
      "Bash(*git add .)",
      "Bash(*git add . *)",
      "Bash(*git add -- .)",
      "Bash(*git add -A*)",
      "Bash(*git add --all*)",
      "PowerShell(*git rebase*)",
      "PowerShell(*--amend*)",
      "PowerShell(*git checkout .)",
      "PowerShell(*git checkout . *)",
      "PowerShell(*git restore .)",
      "PowerShell(*git restore . *)",
      "PowerShell(*git add .)",
      "PowerShell(*git add . *)",
      "PowerShell(*git add -- .)",
      "PowerShell(*git add -A*)",
      "PowerShell(*git add --all*)",
      "Bash(cat *)",
      "Bash(sed -n*)",
      "Bash(sed -i*)"
    ]
  },
  "enabledPlugins": {
    "ponytail@ponytail": true
  }
}
